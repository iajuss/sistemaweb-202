generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorKind {
  HUMAN
  AGENT
  SYSTEM
}

enum HumanRole {
  ADMIN_TENANT
  ANALISTA_DOSSIE
  OPERADOR_COBRANCA
  ENCARREGADO_LGPD
}

enum SourceStatus {
  ENCONTRADO
  NAO_ENCONTRADO
  NAO_CONSULTADO
  ERRO_NA_FONTE
}

model Tenant {
  id         String   @id
  theme      Json?
  createdAt  DateTime @default(now())
  wallets    Wallet[]
  debtors    Debtor[]
  actors     ActorIdentity[]
  grants     AgentWalletGrant[]
  observations Observation[]
}

model Wallet {
  id          String   @id
  tenantId    String
  name        String
  importedAt  DateTime
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  titles      Title[]
  grants      AgentWalletGrant[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Debtor {
  id               String   @id
  tenantId         String
  cpfCiphertext    Bytes
  cpfIv            Bytes
  cpfAuthTag       Bytes
  cpfHmac          String
  hmacKeyReference String
  keyReference     String
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  titles           Title[]
  observations     Observation[]

  @@unique([tenantId, id])
  @@unique([tenantId, cpfHmac])
  @@index([tenantId])
}

model Title {
  id          String   @id
  tenantId    String
  walletId    String
  debtorId    String
  externalId  String
  amountCents BigInt
  dueDate     DateTime
  wallet      Wallet   @relation(fields: [tenantId, walletId], references: [tenantId, id])
  debtor      Debtor   @relation(fields: [tenantId, debtorId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, walletId, externalId])
  @@index([tenantId, debtorId])
}

model ActorIdentity {
  id        String      @id
  tenantId  String
  provider  String
  subject   String
  kind      ActorKind
  roles     HumanRole[]
  active    Boolean     @default(true)
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  grants    AgentWalletGrant[]

  @@unique([tenantId, id])
  @@unique([tenantId, provider, subject])
  @@index([tenantId])
}

model AgentWalletGrant {
  id        String    @id
  tenantId  String
  actorId   String
  walletId  String
  actions   String[]
  revokedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  actor     ActorIdentity @relation(fields: [tenantId, actorId], references: [tenantId, id])
  wallet    Wallet    @relation(fields: [tenantId, walletId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, actorId, walletId])
  @@index([tenantId, walletId])
}

model Observation {
  id          String       @id
  tenantId    String
  debtorId    String
  source      String
  status      SourceStatus
  queryParams Json
  payload     Json?
  collectedAt DateTime
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  debtor      Debtor       @relation(fields: [tenantId, debtorId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, debtorId, source])
}
