+          wallet.id === walletId && wallet.tenantId === context.tenantId,
+      ) ?? null
+    );
+  }
+
+  public async findGrant(
+    context: TenantContext,
+    actorId: string,
+    walletId: string,
+  ): Promise<WalletGrant | null> {
