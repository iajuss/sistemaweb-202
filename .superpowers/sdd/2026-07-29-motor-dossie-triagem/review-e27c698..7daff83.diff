+}));
+
+vi.mock("@prisma/client", () => ({
+  PrismaClient: class {
+    public constructor() {
+      return prismaClientFixture.client as PrismaClient;
+    }
+  },
+  Prisma: { JsonNull: null },
+}));
+
+import {
+  createPrismaObservationRepository,
