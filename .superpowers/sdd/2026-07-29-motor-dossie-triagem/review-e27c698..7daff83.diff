+      id: "observation-a",
+      tenantId: "tenant-a",
+    });
+    expect(events).toEqual([
+      "ROLE_CHECK",
+      "SET_LOCAL:tenant-a",
+      "FIND",
+    ]);
+  });
+
+  it("rejects a database role with BYPASSRLS before an observation query", async () => {
+    const events: string[] = [];
+    const transaction = {
+      $queryRaw: async () => {
+        events.push("ROLE_CHECK");
+        return [{ isSuperuser: false, canBypassRls: true }];
+      },
+      $queryRawUnsafe: async () => {
