+      "ENCONTRADO",
+      "NAO_ENCONTRADO",
+      "NAO_CONSULTADO",
+      "ERRO_NA_FONTE",
+    ]));
+  });
+
+  it("rejects values outside the four distinct states", () => {
+    expect(SourceStatusSchema.safeParse("DESCONHECIDO").success).toBe(false);
+  });
+});
