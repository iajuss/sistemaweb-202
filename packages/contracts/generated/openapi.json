{
  "openapi": "3.1.0",
  "info": {
    "title": "Dossier triage contracts",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Dossier": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "dossier_id": {
            "type": "string",
            "minLength": 1
          },
          "composed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "valor": {
                  "anyOf": [
                    {},
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ENCONTRADO",
                    "NAO_ENCONTRADO",
                    "NAO_CONSULTADO",
                    "ERRO_NA_FONTE"
                  ]
                },
                "fonte": {
                  "type": "object",
                  "properties": {
                    "fonte": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parametros_consulta": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "fonte",
                    "parametros_consulta"
                  ],
                  "additionalProperties": false
                },
                "coletado_em": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "data_referencia": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "confianca_vinculo": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidencia_vinculo": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "valor",
                "status",
                "fonte",
                "coletado_em",
                "data_referencia",
                "confianca_vinculo",
                "evidencia_vinculo"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema_version",
          "dossier_id",
          "composed_at",
          "fields"
        ],
        "additionalProperties": false
      },
      "Classification": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "classification_id": {
            "type": "string",
            "minLength": 1
          },
          "dossier_id": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "classified_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "operational_priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "primary_strategy": {
            "type": "string",
            "minLength": 1
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "minLength": 1
                },
                "peso": {
                  "type": "number"
                },
                "fonte": {
                  "type": "string",
                  "minLength": 1
                },
                "aplicado": {
                  "type": "boolean"
                }
              },
              "required": [
                "nome",
                "peso",
                "fonte",
                "aplicado"
              ],
              "additionalProperties": false
            }
          },
          "explicacao": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "schema_version",
          "classification_id",
          "dossier_id",
          "policy_version",
          "classified_at",
          "category",
          "operational_priority",
          "primary_strategy",
          "signals",
          "explicacao"
        ],
        "additionalProperties": false
      }
    }
  }
}
